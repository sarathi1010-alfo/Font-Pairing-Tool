{
  "service": {
    "name": "fontfusion-pairing",
    "namespace": "sarathi1010-alfo",
    "version": "1.8.0",
    "environment": "production",
    "domain": "https://fontfusion.alfo.online"
  },
  "open_telemetry": {
    "enabled": true,
    "exporter": {
      "type": "otlp-http",
      "endpoint": "https://telemetry.alfo.online/v1/traces",
      "protocol": "http/protobuf"
    },
    "metrics": {
      "endpoint": "https://telemetry.alfo.online/v1/metrics",
      "interval_ms": 30000,
      "tracked_metrics": [
        "font_combination_generated_total",
        "css_export_clicks_total",
        "font_preview_rendering_latency_ms",
        "typography_contrast_check_score",
        "core_web_vitals_lcp_ms",
        "core_web_vitals_cls",
        "core_web_vitals_inp_ms"
      ]
    },
    "tracing": {
      "sampling_rate": 1.0,
      "span_attributes": {
        "app.framework": "Next.js / Tailwind CSS",
        "app.feature": "Typography Engine & Font Pairing Studio",
        "app.tier": "Tier-1 Autonomous SEO Web Utility"
      }
    }
  },
  "audit": {
    "last_audited": "2026-09-30T13:12:00Z",
    "auditor": "Alfo Autonomous Orchestrator",
    "seo_health_score": 98,
    "cwv_status": "PASS",
    "checks": {
      "canonical_urls": "VERIFIED",
      "sitemap_xml": "200 OK (Clean product and article sitemaps indexed)",
      "json_ld_schema": "WebApplication + FAQPage + ItemList structured data",
      "broken_links_404": 0,
      "mobile_responsive_score": 100,
      "indexation_status": "Google Indexing Verified"
    }
  },
  "evaluation": {
    "aeo_geo_readiness_score": 96,
    "ai_engine_optimization": {
      "structured_data_richness": "HIGH",
      "machine_parseable_tables": true,
      "direct_qa_block_present": true,
      "citation_worthiness": "OPTIMAL"
    },
    "performance_benchmarks": {
      "target_lcp_seconds": 1.0,
      "target_cls": 0.01,
      "target_inp_ms": 28
    },
    "next_quarter_goals": [
      "Google Fonts dynamic live pairing visualizer",
      "Automated WCAG AAA typography contrast checker",
      "One-click CSS / Tailwind snippet generation & export"
    ]
  },
  "eval_harness": {
    "framework": "promptfoo",
    "version": "0.98.0",
    "suites": [
      {
        "name": "typography_pairing_aesthetic_eval",
        "type": "multimodal_eval",
        "description": "Validates font pairing harmony, contrast compliance (WCAG AAA), and font load performance",
        "metrics": [
          "contrast_ratio_score",
          "layout_shift_impact",
          "render_time_ms"
        ],
        "thresholds": {
          "min_contrast_ratio": 4.5,
          "max_render_time_ms": 50
        },
        "test_cases_path": "tests/evals/font_pairings_fixture.json"
      },
      {
        "name": "search_engine_llm_citation_eval",
        "type": "search_engine_eval",
        "description": "Evaluates Answer Engine extraction for typography recommendations & CSS codes",
        "metrics": [
          "citation_density",
          "groundedness",
          "code_snippet_parseability"
        ],
        "thresholds": {
          "min_groundedness": 0.95,
          "code_snippet_parseability": 1.0
        }
      }
    ],
    "ci_cd": {
      "run_on_pull_request": true,
      "block_on_failure": true,
      "report_format": [
        "json",
        "markdown"
      ]
    }
  }
}